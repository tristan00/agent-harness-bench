  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Config": {
        "type": "object",
        "properties": {
          "benchmark": {
            "type": "string",
            "enum": [
              "chess960",
              "game_build"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "development_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "enrollment_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400,
            "default": 60
          },
          "judge_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600,
            "default": 300
          },
          "score_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3600,
            "default": 120
          },
          "build_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1800,
            "default": 120
          },
          "seed": {
            "type": "integer",
            "minimum": 0,
            "description": "Fresh random seed when omitted. Explicit values replay chess positions and game order; game inspiration and dashboard datasets are independently assigned per run."
          },
          "positions": {
            "type": "integer",
            "minimum": 1,
            "maximum": 960,
            "default": 4
          },
          "max_plies": {
            "type": "integer",
            "minimum": 2,
            "maximum": 2000,
            "default": 400
          },
          "initial_elo": {
            "type": "number",
            "default": 1500
          },
          "elo_k": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 100,
            "default": 32
          },
          "baselines": {
            "type": "boolean",
            "default": true
          },
          "pool_run_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "uniqueItems": true,
            "maxItems": 16
          }
        },
        "required": [],
        "additionalProperties": false
      },
      "Manifest": {
        "type": "object",
        "properties": {
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 128
          },
          "build": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 128
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "source_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ui": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "web",
              "native",
              null
            ]
          }
        },
        "required": [
          "run"
        ],
        "additionalProperties": false
      },
      "File": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "base64": {
            "type": [
              "string",
              "null"
            ]
          },
          "executable": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "base64": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "base64"
            ],
            "properties": {
              "base64": {
                "type": "string"
              },
              "text": {
                "type": "null"
              }
            }
          }
        ]
      },
      "Submission": {
        "type": "object",
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/File"
            }
          }
        },
        "required": [
          "manifest",
          "files"
        ],
        "additionalProperties": false
      },
      "Start": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "format": "uuid"
          },
          "agent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "campaign_id",
          "agent"
        ],
        "additionalProperties": false
      },
      "Claim": {
        "type": "object",
        "properties": {
          "judge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional run filter for deterministic batch claims"
          }
        },
        "required": [
          "judge"
        ],
        "additionalProperties": false
      },
      "Action": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "params": {}
        },
        "required": [
          "action"
        ]
      },
      "Criterion": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "score",
          "evidence"
        ],
        "additionalProperties": false
      },
      "Score": {
        "type": "object",
        "properties": {
          "interface": {
            "$ref": "#/components/schemas/Criterion"
          },
          "efficiency": {
            "$ref": "#/components/schemas/Criterion"
          },
          "gameplay": {
            "$ref": "#/components/schemas/Criterion"
          },
          "visuals": {
            "$ref": "#/components/schemas/Criterion"
          },
          "testability": {
            "$ref": "#/components/schemas/Criterion"
          },
          "compared_games": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "interface",
          "efficiency",
          "gameplay",
          "visuals",
          "testability",
          "compared_games",
          "notes"
        ],
        "additionalProperties": false
      },
      "CoordinatorStart": {
        "type": "object",
        "properties": {
          "campaign_id": {
            "type": "string",
            "format": "uuid"
          },
          "agent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "profile": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "campaign_id",
          "agent",
          "profile"
        ],
        "additionalProperties": false
      },
      "Iteration": {
        "type": "object",
        "properties": {
          "iteration": {
            "type": "integer",
            "minimum": 1
          },
          "tasks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "submission": {
            "$ref": "#/components/schemas/Submission"
          }
        },
        "required": [
          "iteration",
          "submission"
        ]
      },
      "DashboardScore": {
        "type": "object",
        "properties": {
          "completeness": {
            "$ref": "#/components/schemas/Criterion"
          },
          "information_architecture": {
            "$ref": "#/components/schemas/Criterion"
          },
          "prose_economy": {
            "$ref": "#/components/schemas/Criterion"
          },
          "animation": {
            "$ref": "#/components/schemas/Criterion"
          },
          "originality": {
            "$ref": "#/components/schemas/Criterion"
          },
          "performance": {
            "$ref": "#/components/schemas/Criterion"
          },
          "measurements": {
            "type": "object"
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "completeness",
          "information_architecture",
          "prose_economy",
          "animation",
          "originality",
          "performance",
          "measurements",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  }
}
