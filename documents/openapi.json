    "/v1/benchmark-batches": {
      "post": {
        "summary": "Queue template planner benchmarks",
        "x-auth-role": "admin",
        "responses": {
          "200": {
            "description": "Success; see batches.md for response details"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "max_parallel": {
                    "type": "integer",
                    "minimum": 1,
                    "default": 8,
                    "description": "Maximum active benchmark tasks per batch, with one active task per workspace."
                  },
                  "order_seed": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Optional seed for the persisted workspace/benchmark shuffle. Generated randomly when omitted."
                  }
                }
              }
            }
          }
        }
      },
      "get": {
        "summary": "List benchmark batches",
        "x-auth-role": "admin",
        "responses": {
          "200": {
            "description": "Success; see batches.md for response details"
          }
        }
      }
    },
