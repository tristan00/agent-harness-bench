  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "Manifest": {
        "type": "object",
        "properties": {
          "run": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 128
          },
          "build": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 128
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "source_files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ui": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "web",
              "native",
              null
            ]
          }
        },
        "required": [
          "run"
        ],
        "additionalProperties": false
      },
      "File": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string"
          },
          "text": {
            "type": [
              "string",
              "null"
            ]
          },
          "base64": {
            "type": [
              "string",
              "null"
            ]
          },
          "executable": {
            "type": "boolean",
            "default": false
          }
        },
        "required": [
          "path"
        ],
        "additionalProperties": false,
        "oneOf": [
          {
            "required": [
              "text"
            ],
            "properties": {
              "text": {
                "type": "string"
              },
              "base64": {
                "type": "null"
              }
            }
          },
          {
            "required": [
              "base64"
            ],
            "properties": {
              "base64": {
                "type": "string"
              },
              "text": {
                "type": "null"
              }
            }
          }
        ]
      },
      "Submission": {
        "type": "object",
        "properties": {
          "manifest": {
            "$ref": "#/components/schemas/Manifest"
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1024,
            "items": {
              "$ref": "#/components/schemas/File"
            }
          }
        },
        "required": [
          "manifest",
          "files"
        ],
        "additionalProperties": false
      },
      "Claim": {
        "type": "object",
        "properties": {
          "judge": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "run_id": {
            "type": "string",
            "format": "uuid",
            "description": "Optional run filter for deterministic batch claims"
          }
        },
        "required": [
          "judge"
        ],
        "additionalProperties": false
      },
      "Action": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string"
          },
          "params": {}
        },
        "required": [
          "action"
        ]
      },
      "Criterion": {
        "type": "object",
        "properties": {
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "evidence": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          }
        },
        "required": [
          "score",
          "evidence"
        ],
        "additionalProperties": false
      },
      "Score": {
        "type": "object",
        "properties": {
          "interface": {
            "$ref": "#/components/schemas/Criterion"
          },
          "efficiency": {
            "$ref": "#/components/schemas/Criterion"
          },
          "gameplay": {
            "$ref": "#/components/schemas/Criterion"
          },
          "visuals": {
            "$ref": "#/components/schemas/Criterion"
          },
          "testability": {
            "$ref": "#/components/schemas/Criterion"
          },
          "compared_games": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 500
            }
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "interface",
          "efficiency",
          "gameplay",
          "visuals",
          "testability",
          "compared_games",
          "notes"
        ],
        "additionalProperties": false
      },
      "DashboardScore": {
        "type": "object",
        "properties": {
          "completeness": {
            "$ref": "#/components/schemas/Criterion"
          },
          "information_architecture": {
            "$ref": "#/components/schemas/Criterion"
          },
          "prose_economy": {
            "$ref": "#/components/schemas/Criterion"
          },
          "animation": {
            "$ref": "#/components/schemas/Criterion"
          },
          "originality": {
            "$ref": "#/components/schemas/Criterion"
          },
          "performance": {
            "$ref": "#/components/schemas/Criterion"
          },
          "measurements": {
            "type": "object"
          },
          "notes": {
            "type": "string",
            "maxLength": 20000
          }
        },
        "required": [
          "completeness",
          "information_architecture",
          "prose_economy",
          "animation",
          "originality",
          "performance",
          "measurements",
          "notes"
        ],
        "additionalProperties": false
      }
    }
  }
}
